!storage/database/.gitkeep
!storage/images/.gitkeep
!storage/images/originals/.gitkeep
!storage/images/edited/.gitkeep
!storage/images/exports/.gitkeep
!storage/cache/.gitkeep

# Uploads
public/uploads/*
