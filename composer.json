{
    "name": "xerofluxdev/ai-image-generator",
    "description": "AI-powered image generation and editing application using OpenRouter API",
    "type": "project",
    "license": "MIT",
    "authors": [
        {
            "name": "XeroFluxDev",
            "email": "dev@xeroflux.com"
        }
    ],
    "require": {
        "php": ">=8.1",
        "intervention/image": "^3.0",
        "vlucas/phpdotenv": "^5.5"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "serve": "php -S localhost:8000 -t public"
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
